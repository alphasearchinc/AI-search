version: "3.9"

services:
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:8.14.0
    environment:
      - discovery.type=single-node
      - ES_JAVA_OPTS=-Xms{{ es_heap }} -Xmx{{ es_heap }}
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - esdata:/usr/share/elasticsearch/data
    ports:
      - "9200:9200"
    networks:
      - medusa_net

  redis:
    image: redis:7
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redisdata:/data
    ports:
      - "6379:6379"
    networks:
      - medusa_net

  medusa:
    image: "{{ medusa_image }}:{{ medusa_image_tag }}"
    env_file:
      - .env
    depends_on:
      - redis
      - elasticsearch
    ports:
      - "{{ medusa_port }}:{{ medusa_port }}"
    networks:
      - medusa_net

networks:
  medusa_net:

volumes:
  esdata:
    driver: local
  redisdata:
    driver: local
